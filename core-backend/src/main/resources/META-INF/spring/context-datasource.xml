<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	 <!-- 환경설정 기본정보를 globals.properties 에서 참조하도록 propertyConfigurer 설정  -->
    <bean id="environmentVariablesConfiguration" class="org.jasypt.encryption.pbe.config.EnvironmentStringPBEConfig">  
        <property name="algorithm" value="PBEWithMD5AndDES" />  
        <property name="password" value="JBIT_PASS" />
	</bean>  
	       
	<bean id="configurationEncryptor" class="org.jasypt.encryption.pbe.StandardPBEStringEncryptor">  
	        <property name="config" ref="environmentVariablesConfiguration" />  
	</bean>  
		      
	<bean id="propertyConfigurer" class="org.jasypt.spring3.properties.EncryptablePropertyPlaceholderConfigurer">  
        <constructor-arg ref="configurationEncryptor" />  
        <property name="locations">  
            <list>  
               <value>classpath:/META-INF/props/globals.properties</value>
            </list>  
        </property>  
	</bean>  

	<!-- 환경설정 기본정보를 globals.properties 에서 참조하도록 propertyConfigurer 설정
    <bean id="propertyConfigurer"
        class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="locations">
            <list>
                <value>classpath:/META-INF/props/globals.properties</value>
            </list>
        </property>
    </bean>
 	-->
	<!-- DB connect -->
	<bean id="dataSourceSpied" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
		<property name="driverClassName" value="${Globals.DriverClassName}"/>
        <property name="url" value="${Globals.Url}" />
        <property name="username" value="${Globals.UserName}"/>
        <property name="password" value="${Globals.Password}"/>
		<!-- 2-35차 (사용자 승인): 주석 처리돼 있던 풀 설정을 되살렸다. 그동안은 commons-dbcp 1.4 기본값
		     (최대 8개, 대기 무제한 -1)이라 연결이 바닥나면 요청이 끝없이 기다리며 서버가 멈출 수 있었다.
		     운영 DB max_connections=151, 실측 최대 사용 21 (2026-10-21) — 30개면 여유가 있다.
		     maxWait 10초: 바닥나면 10초 뒤 오류를 내고 DB 연결 경보로 잡힌다 -->
		<property name="initialSize" value="5" />
		<property name="maxActive" value="30" />
		<property name="maxIdle" value="30" />
		<property name="maxWait" value="10000" />
		<property name="validationQuery" value="SELECT 1 " />
		<property name="testOnBorrow" value="false" />
		<property name="testOnReturn" value="false" />
		<property name="testWhileIdle" value="true" />
		<property name="timeBetweenEvictionRunsMillis" value="300000" />
		<property name="minEvictableIdleTimeMillis" value="60000" />
	</bean>

	<!-- DB logging -->
	<bean id="dataSource" class="net.sf.log4jdbc.Log4jdbcProxyDataSource">
		<constructor-arg ref="dataSourceSpied" />
		<property name="logFormatter">
			<bean class="net.sf.log4jdbc.tools.Log4JdbcCustomFormatter">
				<property name="loggingType" value="MULTI_LINE" />
				<property name="sqlPrefix" value="SQL     :::" />
			</bean>
		</property>
	</bean>
</beans>